# Kong gateway URL - deployed live URL by default; override with http://localhost:8000 for
# local backend development. Note: no /api/v1 suffix - src/lib/api.ts appends full paths itself
NEXT_PUBLIC_API_URL=https://api.mindora.rw

# Messaging Service's Socket.io server. The backend bundle only gets Kong as a public
# domain in production (see DP.md) - messaging-service itself has no separate public
# host - so this now goes through Kong too, via the `messaging-socket` route in
# infrastructure/kong/kong.railway.yml (proxies /socket.io, no JWT plugin - the token
# travels inside the Engine.io connect payload, verified by socket.ts's own handshake
# auth). Live-verified: a real socket.io-client can connect and authenticate through
# Kong on this path. For local backend development, use http://localhost:3006 (or
# http://localhost:8000 - the local kong.yml has the same proxy route for parity).
NEXT_PUBLIC_SOCKET_URL=https://api.mindora.rw
