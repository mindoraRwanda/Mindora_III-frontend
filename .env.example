# Kong gateway URL - deployed live URL by default; override with http://localhost:8000 for
# local backend development. Note: no /api/v1 suffix - src/lib/api.ts appends full paths itself
NEXT_PUBLIC_API_URL=https://api.mindora.rw

# Messaging Service's Socket.io server. Confirmed NOT to go through Kong - there is no
# /socket.io/ route on the gateway, so this must be the messaging service's own host, not
# NEXT_PUBLIC_API_URL. The value below is a placeholder; get the real deployed host from the
# backend team before shipping. For local backend development, use http://localhost:3006.
NEXT_PUBLIC_SOCKET_URL=https://api.mindora.rw
