# Kong gateway URL — deployed live URL by default; override with http://localhost:8000 for
# local backend development. Note: no /api/v1 suffix — src/lib/api.ts appends full paths itself
NEXT_PUBLIC_API_URL=https://api.mindora.rw

# Messaging Service's Socket.io server. In production this goes through the same Kong
# gateway host as everything else; for local backend development override with
# http://localhost:3006 (the docs don't specify a separate gateway path for this service).
NEXT_PUBLIC_MESSAGING_WS_URL=https://api.mindora.rw
